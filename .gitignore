# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# runtime data — customer reviews, uploaded photos and orders.
# This is the store's data folder; swap it for a real database later.
/.data/

# debug / logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the example stays, so the variables above are discoverable.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
