# The admin sign-in for /admin.
#
# Copy this file to `.env.local` and fill it in — `.env*` files are never
# committed, this example is.
#
#   ADMIN_EMAIL          the address the studio signs in with
#   ADMIN_PASSWORD       the password for that address
#   ADMIN_SESSION_SECRET a long random string that signs the session cookie
#                        (generate one with: openssl rand -hex 32)
#
# With these set, only the address and password above can sign in. Without
# them, a development machine falls back to a clearly marked development
# sign-in and a production server refuses to sign anybody in at all.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Payments (Stripe Checkout)
# ---------------------------------------------------------------------------
#
#   STRIPE_SECRET_KEY      the secret key from the Stripe dashboard
#                           (sk_test_… in test mode, sk_live_… in live mode).
#                           Without it the shop offers cash on delivery only.
#   STRIPE_WEBHOOK_SECRET  the signing secret of the Stripe webhook, found
#                           in the webhook's settings. Without it the
#                           webhook cannot verify what it is told, so no
#                           order can ever be marked as paid by card.
#   PAYMENT_CURRENCY       the currency the card is charged in when the
#                           visitor's own currency is not one the provider
#                           takes (default: USD). The order always keeps
#                           its totals in PKR.
#   COD_ENABLED            cash on delivery: true or false. On unless it
#                           says otherwise.
#
# The webhook to point Stripe at:
#
#   https://<your-domain>/api/webhooks/stripe
#
# and the events to send: checkout.session.completed and
# checkout.session.expired.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_CURRENCY=USD
COD_ENABLED=true

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
#
#   RESEND_API_KEY     the API key from the Resend dashboard. Without it the
#                      shop still takes orders — the messages are written to
#                      the terminal instead of being sent.
#   EMAIL_FROM         the address the shop sends from, e.g.
#                      "Rung E Bahar <orders@rungebahar.com>". The domain has
#                      to be one Resend is allowed to send from.
#   ORDER_NOTICE_EMAIL where new-order notices go (default: the address in
#                      src/data/site.ts).
#   STORE_URL          the address of the shop, used for the links inside
#                      the emails (default: the SITE_URL in src/lib/seo.ts).
RESEND_API_KEY=
EMAIL_FROM=
ORDER_NOTICE_EMAIL=
STORE_URL=

# ---------------------------------------------------------------------------
# Newsletter
# ---------------------------------------------------------------------------
#
#   NEWSLETTER_SECRET  a long random string that signs the confirmation and
#                      unsubscribe links (generate one with:
#                      openssl rand -hex 32). A production server refuses to
#                      run the newsletter without it, because a link that
#                      anyone could make would be a link to anybody's
#                      subscription.
NEWSLETTER_SECRET=

# ---------------------------------------------------------------------------
# Analytics (optional)
# ---------------------------------------------------------------------------
#
#   NEXT_PUBLIC_ANALYTICS_SRC  the script the cookie banner loads once the
#                      visitor has accepted. Nothing is loaded until they
#                      have, and nothing is loaded at all without this.
NEXT_PUBLIC_ANALYTICS_SRC=

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
#
#   NEXT_PUBLIC_SUPABASE_URL               the project URL, e.g.
#                                          https://<project-ref>.supabase.co
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY   the publishable key from the
#                                          Supabase dashboard. It is safe to
#                                          expose to the browser; never put the
#                                          service-role key in a NEXT_PUBLIC_
#                                          variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
